{
  "name": "dsh-chat-import",
  "description": "Import Claude Code / Codex / ChatGPT / Cursor / Gemini / Reasonix / opencode conversation histories as resumable DeepSeek Harness sessions",
  "version": "0.1.1",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./CHANGELOG.md": "./CHANGELOG.md",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "convert.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "assets/import.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "claude-code",
    "codex",
    "chatgpt",
    "cursor",
    "gemini",
    "reasonix",
    "opencode",
    "sqlite",
    "import",
    "jsonl",
    "migration",
    "transcript"
  ],
  "author": "Nwflower <1679659@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nwflower/dsh-chat-import.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test && git diff --quiet && git diff --cached --quiet && npm pack --dry-run"
  },
  "license": "MIT"
}
